# Copy to .env, fill in, and source it:
#
#   cp scripts/catalog-publish/env.example scripts/catalog-publish/.env
#   set -a; . scripts/catalog-publish/.env; set +a
#
# .env is gitignored. This file must never carry real credentials.

# ---- what the run does with what it builds -------------------------------
# files | api | both
OUTPUT_MODE=files
CATALOG_OUT_DIR=./catalogs

# ---- where it publishes --------------------------------------------------
# Discovery's own address, NOT the provider adapter's: the adapter's /publish
# is MERGE-only and would reject the FULL this pipeline sends.
# Unused when OUTPUT_MODE=files.
DISCOVERY_URL=http://localhost:8090

# The network these catalogs are visible to. Required in EVERY mode -- it is
# stamped into the documents, so a files-only run without it writes catalogs
# that are visible to no one.
NETWORK_ID=oan.dev

# ---- who publishes -------------------------------------------------------
MANDI_PARTICIPANT_ID=agmarknet

# ---- the upstream --------------------------------------------------------
MANDI_API_URI=http://localhost:9101

# The window. `today`, `yesterday`, `N days ago`, or an explicit dd-MM-yyyy.
# Seven days rather than one: the onDemand catalog is a directory of markets
# and what each deals in, so a single day makes every Sunday and holiday
# publish almost nothing.
MANDI_FROM_DATE=7 days ago
MANDI_TO_DATE=yesterday

# ---- credentials ---------------------------------------------------------
# These cannot live in catalog-publish.yaml: the engine refuses to let a
# config override an input the pipeline marks `secret`.
MANDI_TOKEN_USER=
MANDI_TOKEN_SECRET=
