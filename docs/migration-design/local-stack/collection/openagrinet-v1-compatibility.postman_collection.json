    {
      "name": "1. V1 in, V1 out",
      "description": "A request exactly as BharatVistaar sends it today, answered in the shape\nBharatVistaar expects. Between the two, the request left as a V2 select and\nthe V2 answer was mapped back. Nothing in either payload here is V2.\n\nSend these first. They are the whole claim.",
      "item": [
        {
          "name": "happy  (all five forecast days present)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"context\": {\n    \"domain\": \"schemes:vistaar\",\n    \"action\": \"search\",\n    \"version\": \"1.1.0\",\n    \"bap_id\": \"local-harness\",\n    \"bap_uri\": \"http://localhost\",\n    \"transaction_id\": \"11111111-1111-1111-1111-111111111111\",\n    \"message_id\": \"22222222-2222-2222-2222-222222222222\",\n    \"timestamp\": \"1762243200\",\n    \"ttl\": \"PT10M\",\n    \"tags\": {\n      \"session_id\": \"local-session\",\n      \"question_id\": \"local-question\"\n    }\n  },\n  \"message\": {\n    \"intent\": {\n      \"category\": {\n        \"descriptor\": {\n          \"name\": \"Weather-Forecast-Mausamgram\",\n          \"code\": \"WFC\"\n        }\n      },\n      \"fulfillment\": {\n        \"stops\": [\n          {\n            \"location\": {\n              \"lat\": \"18.4\",\n              \"lon\": \"74.4\"\n            }\n          }\n        ]\n      }\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{v1Adapter}}/mobility/search",
              "host": [
                "{{v1Adapter}}/mobility/search"
              ]
            },
            "description": "Provider behaviour: all five forecast days present.\n\nExpected: five day groups, Today through Day_5."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// V1 is a Nest service and answers 201 on POST. The adapter is configured",
                  "// to match, because a status code is part of the contract too.",
                  "pm.test('201, the status V1 sends', () => pm.response.to.have.status(201));",
                  "",
                  "const providers = pm.response.json().message.catalog.providers;",
                  "pm.test('a forecast came back', () => pm.expect(providers).to.not.be.empty);",
                  "const tags = providers[0].items[0].tags;",
                  "pm.test('the first day is labelled Today', () =>",
                  "  pm.expect(tags[0].descriptor.code).to.eql('Today'));",
                  "pm.test('every day carries all ten readings', () =>",
                  "  tags.forEach(t => pm.expect(t.list).to.have.lengthOf(10)));"
                ]
              }
            }
          ]
        },
