    },
    {
      "name": "3. Inside the hop",
      "description": "The two legs the V1 adapter makes on your behalf, drivable on their own.\n\nThe select is what leaves the V1 adapter; the GET is what leaves the V2 one.\nRun the select and compare its answer to the V1 body above and you can see\nexactly what the V2 representation keeps and what it drops.",
      "item": [
        {
          "name": "the V2 select the V1 adapter sends",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"context\": {\n    \"version\": \"2.0.0\",\n    \"action\": \"select\",\n    \"networkId\": \"openagrinet.local\",\n    \"receiverId\": \"oan.local\",\n    \"transactionId\": \"11111111-1111-1111-1111-111111111111\",\n    \"messageId\": \"22222222-2222-2222-2222-222222222222\",\n    \"timestamp\": \"2026-01-01T00:00:00Z\"\n  },\n  \"message\": {\n    \"contract\": {\n      \"commitments\": [\n        {\n          \"status\": {\n            \"descriptor\": {\n              \"code\": \"ACTIVE\",\n              \"name\": \"active\"\n            }\n          },\n          \"offer\": {\n            \"id\": \"offer:mausamgram:open-data\",\n            \"resourceIds\": [\n              \"res:mausamgram:point-forecast\"\n            ],\n            \"provider\": {\n              \"id\": \"mausamgram\",\n              \"descriptor\": {\n                \"code\": \"IMD-NWP-01\",\n                \"name\": \"IMD Mausamgram NWP\"\n              }\n            }\n          },\n          \"resources\": [\n            {\n              \"id\": \"res:mausamgram:point-forecast\",\n              \"quantity\": {\n                \"count\": 1\n              },\n              \"resourceAttributes\": {\n                \"@context\": \"https://schemas.openagrinet.global/schema/WeatherObservation/v0.1/context.jsonld\",\n                \"@type\": \"openagrinet:WeatherObservation\",\n                \"informationMode\": \"OnDemand\",\n                \"subjectCategories\": [\n                  \"Weather\"\n                ],\n                \"location\": {\n                  \"geo\": {\n                    \"type\": \"Point\",\n                    \"coordinates\": [\n                      74.4,\n                      18.4\n                    ]\n                  }\n                }\n              }\n            }\n          ]\n        }\n      ]\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{v2Adapter}}/select",
              "host": [
                "{{v2Adapter}}/select"
              ]
            },
            "description": "What the request half of the V1 mapping produces. A V2 caller sends\nexactly this; the V1 adapter is not a privileged client."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const res = pm.response.json().message.contract.commitments[0].resources;",
                  "pm.test('one resource per forecast day', () =>",
                  "  pm.expect(res.length).to.be.above(0));",
                  "// Every day is a separate resource with its own validity window. The",
                  "// day NUMBER is not on the wire: the V1 mapping recovers it from the",
                  "// date, which works because fcstday1 is today for this provider.",
                  "pm.test('each day carries a validity window and no day number', () =>",
                  "  res.forEach(r => {",
                  "    pm.expect(r.resourceAttributes.validity.startsAt).to.be.a('string');",
                  "    pm.expect(JSON.stringify(r)).to.not.include('Day_');",
                  "  }));"
                ]
              }
            }
          ]
        },
        {
          "name": "the provider GET the V2 adapter sends",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{provider}}/get-daily?lat=18.4&lon=74.4",
              "host": [
                "{{provider}}/get-daily?lat=18.4&lon=74.4"
              ]
            },
            "description": "Mausamgram's own shape, before anything maps it. Needs the Basic\ncredential, which is set on this folder and is fake.\n\nChange lat to 1.1, 2.2 or 3.3 to pick a different scenario."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "// cloud_message is the field with nowhere to go in V2. V1 renders it",
                  "// as Weather Condition when there is no warning; the V2 parameter",
                  "// enum has no member that holds prose, so it is dropped and the V1",
                  "// adapter can only say N/A. It is the one real loss in the five",
                  "// scenarios, and you can see it originate here.",
                  "pm.test('the provider sends a prose cloud summary', () =>",
                  "  pm.expect(pm.response.json().fcstday1).to.have.property('cloud_message'));"
                ]
              }
            }
          ]
        }
      ],
