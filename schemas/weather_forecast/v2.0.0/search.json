{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "search",
  "type": "object",
  "required": [
    "context",
    "message"
  ],
  "properties": {
    "context": {
      "allOf": [
        {
          "$ref": "./definitions.json#/$defs/Context"
        }
      ],
      "required": [
        "domain",
        "action",
        "version",
        "bap_id",
        "bap_uri",
        "transaction_id",
        "message_id",
        "timestamp"
      ],
      "properties": {
        "domain": {
          "const": "weather:forecast"
        },
        "version": {
          "const": "2.0.0"
        },
        "action": {
          "const": "search"
        }
      }
    },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intent"
      ],
      "properties": {
        "intent": {
          "allOf": [
            {
              "$ref": "./definitions.json#/$defs/Intent"
            }
          ],
          "required": [
            "fulfillment"
          ],
          "properties": {
            "fulfillment": {
              "required": [
                "stops"
              ],
              "properties": {
                "stops": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "required": [
                      "location"
                    ],
                    "properties": {
                      "location": {
                        "required": [
                          "gps"
                        ]
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
