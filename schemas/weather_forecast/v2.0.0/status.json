{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "status",
  "type": "object",
  "required": [
    "context",
    "message"
  ],
  "properties": {
    "context": {
      "allOf": [
        {
          "$ref": "./definitions.json#/$defs/Context"
        }
      ],
      "required": [
        "domain",
        "action",
        "version",
        "bap_id",
        "bap_uri",
        "transaction_id",
        "message_id",
        "timestamp"
      ],
      "properties": {
        "domain": {
          "const": "weather:forecast"
        },
        "version": {
          "const": "2.0.0"
        },
        "action": {
          "const": "status"
        }
      }
    },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "order_id"
      ],
      "properties": {
        "order_id": {
          "type": "string"
        },
        "ref_id": {
          "type": "string"
        }
      }
    }
  }
}
