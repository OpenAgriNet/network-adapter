{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "on_status",
  "type": "object",
  "required": [
    "context",
    "message"
  ],
  "properties": {
    "context": {
      "allOf": [
        {
          "$ref": "./definitions.json#/$defs/Context"
        }
      ],
      "required": [
        "domain",
        "action",
        "version",
        "bap_id",
        "bap_uri",
        "bpp_id",
        "bpp_uri",
        "transaction_id",
        "message_id",
        "timestamp"
      ],
      "properties": {
        "domain": {
          "const": "weather:forecast"
        },
        "version": {
          "const": "2.0.0"
        },
        "action": {
          "const": "on_status"
        }
      }
    },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "order"
      ],
      "properties": {
        "order": {
          "allOf": [
            {
              "$ref": "./definitions.json#/$defs/Order"
            }
          ],
          "required": [
            "id",
            "status",
            "fulfillments"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "status": {
              "enum": [
                "ACTIVE",
                "COMPLETE",
                "CANCELLED"
              ]
            },
            "fulfillments": {
              "type": "array",
              "minItems": 1,
              "items": {
                "required": [
                  "tags"
                ],
                "properties": {
                  "tags": {
                    "type": "array",
                    "minItems": 2,
                    "contains": {
                      "required": [
                        "descriptor"
                      ],
                      "properties": {
                        "descriptor": {
                          "properties": {
                            "code": {
                              "const": "units"
                            }
                          },
                          "required": [
                            "code"
                          ]
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "error": {
      "$ref": "./definitions.json#/$defs/Error"
    }
  }
}
