{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "on_init",
  "type": "object",
  "required": [
    "context",
    "message"
  ],
  "properties": {
    "context": {
      "allOf": [
        {
          "$ref": "./definitions.json#/$defs/Context"
        }
      ],
      "required": [
        "domain",
        "action",
        "version",
        "bap_id",
        "bap_uri",
        "bpp_id",
        "bpp_uri",
        "transaction_id",
        "message_id",
        "timestamp"
      ],
      "properties": {
        "domain": {
          "const": "weather:forecast"
        },
        "version": {
          "const": "2.0.0"
        },
        "action": {
          "const": "on_init"
        }
      }
    },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "order"
      ],
      "properties": {
        "order": {
          "allOf": [
            {
              "$ref": "./definitions.json#/$defs/Order"
            }
          ],
          "required": [
            "quote",
            "payments"
          ],
          "properties": {
            "quote": {
              "required": [
                "price"
              ]
            },
            "payments": {
              "type": "array",
              "minItems": 1
            }
          }
        }
      }
    },
    "error": {
      "$ref": "./definitions.json#/$defs/Error"
    }
  }
}
